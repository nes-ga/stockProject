{
  "name": "stockmon-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/build-news-dashboard.mjs",
    "build:news-dashboard": "node scripts/build-news-dashboard.mjs",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "refresh:swing-picks": "tsx scripts/refresh-server-swing-picks.ts",
    "scan:swing-universe": "npm.cmd run build && node dist/scripts/scanUniverseSwingPicks.js",
    "scan:dividend-universe": "npm.cmd run build && node dist/scripts/scanUniverseDividendPicks.js",
    "scan:long-term": "npm.cmd run build && node dist/scripts/scanLongTermLeaders.js",
    "scan:long-term-universe": "npm.cmd run build && node dist/scripts/scanUniverseLongTermPicks.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lightweight-charts": "^5.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
